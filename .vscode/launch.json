{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run DeckCraft Extension",
      "type": "extensionDevelopmentHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/samples/sample.pptx"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build-dev"
    }
  ]
}
